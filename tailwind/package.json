{
  "name": "cve3po-tailwind",
  "version": "1.0.0",
  "private": true,
  "description": "Ahead-of-time Tailwind build for CVE3PO (replaces the runtime Play CDN).",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i input.css -o ../vuln_manager/static/vuln_manager/css/app.css --minify",
    "watch": "tailwindcss -c tailwind.config.js -i input.css -o ../vuln_manager/static/vuln_manager/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "tailwindcss": "^3.4.17"
  }
}
