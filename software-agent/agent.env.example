# Required: inventory endpoint in CVE3PO
SOFTWARE_API_URL=https://cve3po.example.com/extensions/agent/inventory/

# Auth header mode: bearer (Authorization: Bearer <token>) or x-api-key
SOFTWARE_API_AUTH=bearer

# Token for bearer or x-api-key mode
SOFTWARE_API_BEARER_TOKEN=replace_me

# Optional: force host IP instead of auto-detection
# HOST_IP=10.0.0.10

# Optional: override the auto-detected hostname (default: system hostname)
# HOSTNAME=web-01

# Optional: override the auto-detected OS (default: /etc/os-release PRETTY_NAME,
# or the Windows product caption). Sending this lets the server scope OSV lookups
# to the right Debian/Ubuntu release.
# OPERATING_SYSTEM=Debian GNU/Linux 12 (bookworm)

# Optional: override the auto-detected running kernel (Linux only; default:
# /proc/sys/kernel/osrelease or `uname -r`). Not sent on non-Linux hosts.
# RUNNING_KERNEL=6.8.0-45-generic

# Optional: override the stable machine identity (default: Linux /etc/machine-id
# or Windows MachineGuid). This is the primary key the server uses to keep a
# multi-homed server as ONE asset, so normally leave auto-detection on.
# MACHINE_ID=

# Optional: comma-separated list of all IPs for this host (default: auto-detected
# via `hostname -I` on Linux / Get-NetIPAddress on Windows). Pre-registering every
# IP means later Wazuh/Shodan alerts on any of them map to this same asset.
# IP_ADDRESSES=10.0.0.10,10.0.1.10,203.0.113.5

# Optional: only print payload, do not send
# DRY_RUN=true
